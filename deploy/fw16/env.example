# ~/wieplay-gpu/<env>.env on the GPU host (prod.env, dev.env). No secrets here: the worker
# token is in ~/wieplay-gpu/<env>.token (0600; `python -m wieplay.cli create-worker` in the
# API container shows it once). scripts/deploy-gpu-worker.sh writes this file from here the
# first time (with dev's port and folders for dev) and leaves it alone afterwards.

# The API through wieplay-gpu-tunnel.service: dev 18090, prod 18091.
WIEPLAY_WORKER_API_URL=http://127.0.0.1:18091
# GPU work only. Give the worker the same caps in the API (create-worker NAME cuda,ml) and
# send the players job there (API: WIEPLAY_PLAYERS_CAPS=cuda,ml).
WIEPLAY_WORKER_CAPS=cuda,ml
WIEPLAY_WORKER_WORK_DIR=/home/luca-canepa/wieplay-gpu/work-prod
# No NAS share on the laptop: the players job reads the 1080p rendition from the bucket
# through signed URLs and writes its files there (PLAN §8.2).
WIEPLAY_WORKER_PLAYERS_SOURCE=bucket
WIEPLAY_WORKER_RAW_ROOT=/nonexistent
WIEPLAY_WORKER_PLAYERS_WEIGHTS=/home/luca-canepa/wieplay-gpu/weights
WIEPLAY_WORKER_PLAYERS_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
# Players v2: follow the people through the dead time of a set (rallies < 40 s apart).
WIEPLAY_WORKER_PLAYERS_JOIN_GAP_S=40
WIEPLAY_WORKER_ANALYSIS_THREADS=8
# The busy guard (wieplay/worker/gpu_guard.py).
WIEPLAY_WORKER_GPU_GUARD=true
WIEPLAY_WORKER_GPU_MAX_OTHER_MIB=1024
WIEPLAY_WORKER_GPU_MAX_UTIL=40
WIEPLAY_WORKER_GPU_NEED_MAINS=true
WIEPLAY_WORKER_GPU_PAUSE_FILE=/home/luca-canepa/wieplay-gpu/PAUSE
WIEPLAY_WORKER_GPU_LOCK_FILE=/home/luca-canepa/wieplay-gpu/gpu.lock
WIEPLAY_WORKER_GPU_MAX_PAUSE_S=1200
WIEPLAY_WORKER_GPU_MEM_LIMIT_MIB=2048
