# /opt/wieplay-<env>/.env on the VPS (mode 0600). Values in angle brackets are secrets:
# keep them in the password vault, never in git.

# Compose
WIEPLAY_TAG=<git sha, set by scripts/deploy.sh>
WIEPLAY_PORT=8090                     # dev 8090, prod 8091; the Cloudflare Tunnel points here

# Leave WIEPLAY_TAILNET_IP unset: since 16.10.2026 the VPS is on no tailnet, so the API stays
# on loopback only. The media workers reach it through an SSH tunnel to 127.0.0.1
# (deploy/lenovo/wieplay-api-tunnel.service, PLAN §8.1).
# WIEPLAY_TAILNET_IP=

# App
WIEPLAY_ENV=dev                       # dev | prod
WIEPLAY_PUBLIC_URL=https://wieplay-dev.kscw.ch
WIEPLAY_DATABASE_URL=postgresql+psycopg://wieplay_dev:<password>@kscw-postgres:5432/wieplay_dev
WIEPLAY_COOKIE_SECURE=true
WIEPLAY_SYNC_INTERVAL_MINUTES=60

# Wiedisync bridge (kscw-endpoints wieplay-bridge.js)
WIEPLAY_BRIDGE_AUTHORIZE_URL=https://directus-dev.kscw.ch/kscw/wieplay/v1/authorize
WIEPLAY_BRIDGE_API_URL=http://directus-kscw-dev:8055/kscw/wieplay/v1
WIEPLAY_BRIDGE_ISSUER=wiedisync-dev
WIEPLAY_BRIDGE_SERVICE_TOKEN=<random 32+ bytes; its sha256 goes into Directus WIEPLAY_SYNC_TOKEN_HASH>
WIEPLAY_BRIDGE_PUBLIC_KEYS={"<kid>":"-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----\n"}

# Object storage (Hetzner Object Storage, S3 API). Leave WIEPLAY_S3_ENDPOINT empty to run
# without video. After the first deploy: docker compose run --rm api python -m wieplay.cli storage-setup
WIEPLAY_S3_ENDPOINT=https://<location>.your-objectstorage.com
WIEPLAY_S3_REGION=<location, e.g. fsn1>
WIEPLAY_S3_BUCKET=kscw-wieplay-dev
WIEPLAY_S3_ACCESS_KEY=<access key>
WIEPLAY_S3_SECRET_KEY=<secret key>
