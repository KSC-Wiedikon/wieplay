# /opt/nomal-<env>/.env on the VPS (mode 0600). Values in angle brackets are secrets:
# keep them in the password vault, never in git.

# Compose
NOMAL_TAG=<git sha, set by scripts/deploy.sh>
NOMAL_PORT=8090                     # dev 8090, prod 8091; the Cloudflare Tunnel points here

# App
NOMAL_ENV=dev                       # dev | prod
NOMAL_PUBLIC_URL=https://nomal-dev.kscw.ch
NOMAL_DATABASE_URL=postgresql+psycopg://nomal_dev:<password>@kscw-postgres:5432/nomal_dev
NOMAL_COOKIE_SECURE=true
NOMAL_SYNC_INTERVAL_MINUTES=60

# Wiedisync bridge (kscw-endpoints nomal-bridge.js)
NOMAL_BRIDGE_AUTHORIZE_URL=https://directus-dev.kscw.ch/kscw/nomal/v1/authorize
NOMAL_BRIDGE_API_URL=http://directus-kscw-dev:8055/kscw/nomal/v1
NOMAL_BRIDGE_ISSUER=wiedisync-dev
NOMAL_BRIDGE_SERVICE_TOKEN=<random 32+ bytes; its sha256 goes into Directus NOMAL_SYNC_TOKEN_HASH>
NOMAL_BRIDGE_PUBLIC_KEYS={"<kid>":"-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----\n"}
