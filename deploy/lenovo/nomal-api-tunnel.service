# /etc/systemd/system/nomal-api-tunnel.service on the Lenovo server: how the media workers
# reach the Nomal APIs on the VPS (PLAN §8.1).
#
# Since 16.10.2026 the VPS belongs to the club's Hetzner account and is on no tailnet; the
# APIs listen on its loopback only (127.0.0.1:8090 dev, 127.0.0.1:8091 prod). This unit
# connects out from the Lenovo server and forwards both to the Docker bridge (docker0), where
# the worker containers reach them:
#   dev   NOMAL_WORKER_API_URL=http://172.17.0.1:18090  (~/stacks/nomal-worker-dev/.env)
#   prod  NOMAL_WORKER_API_URL=http://172.17.0.1:18091  (~/stacks/nomal-worker-prod/.env)
# The VPS has no way into the home network. Requests through the tunnel carry no
# CF-Connecting-IP, so the worker routes accept them; from the internet they stay unreachable.
#
# Needs: User= has a key-only login to the VPS under the ssh alias `hetzner` (BatchMode: it
# never prompts) and the VPS host key in known_hosts. ControlMaster=no and ControlPath=none
# matter when the ssh config multiplexes connections: without them the unit hands its
# forwards to a shared connection and exits.
#
# Install, as root:
#   install -m 0644 deploy/lenovo/nomal-api-tunnel.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now nomal-api-tunnel.service
#   ufw allow proto tcp from 172.16.0.0/12 to 172.17.0.1 port 18090,18091
# The ufw rule lets Docker networks, and nothing else, reach the two ports.
[Unit]
Description=SSH tunnel: Nomal media workers -> Nomal APIs on the VPS (dev 8090, prod 8091)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=lucanepa
ExecStart=/usr/bin/ssh -N -o ControlMaster=no -o ControlPath=none -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=15 -L 172.17.0.1:18090:127.0.0.1:8090 -L 172.17.0.1:18091:127.0.0.1:8091 hetzner
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
