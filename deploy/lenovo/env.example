# ~/stacks/wieplay-worker-<env>/.env on the Lenovo server. No secrets here: the worker token
# lives in ./worker.token (0600) next to compose.yaml.
WIEPLAY_TAG=<git sha, set by scripts/deploy-worker.sh>

# The API through the SSH tunnel wieplay-api-tunnel.service (next to this file; worker routes
# refuse anything that came through Cloudflare). It publishes the VPS's loopback-only APIs on
# the Docker bridge: dev http://172.17.0.1:18090, prod http://172.17.0.1:18091.
WIEPLAY_WORKER_API_URL=http://172.17.0.1:18090
# "analyse" adds a background lane for the automatic analysis (PLAN §10.1): it runs next to
# the media jobs, at low CPU priority, and never holds up an upload. Give the worker the cap
# in the API too: python -m wieplay.cli add-worker-cap <name> analyse
WIEPLAY_WORKER_CAPS=ingest,transcode,thumbs,nas,inbox,analyse
WIEPLAY_WORKER_ENCODER=vaapi
WIEPLAY_WORKER_THREADS=6
# Threads for the ball tracker (ONNX Runtime). Decoding on the CPU ("none") was as fast as
# VAAPI and found a few more balls (16.10.2026); "vaapi" keeps the CPU freer.
WIEPLAY_WORKER_ANALYSIS_THREADS=6
WIEPLAY_WORKER_ANALYSIS_HWACCEL=none

# NAS shares, mounted on the Lenovo server (autofs). dev and prod use separate folders.
WIEPLAY_NAS_RAW=/mnt/nas/wieplay/raw-dev
WIEPLAY_NAS_INBOX=/mnt/nas/wieplay/inbox-dev
# Analysis signals and rally models (mkdir once; owned like raw/).
WIEPLAY_NAS_ANALYSIS=/mnt/nas/wieplay/analysis-dev
WIEPLAY_RENDER_GID=<getent group render | cut -d: -f3>
# Owner of the NAS mount (fstab uid=/gid=), so the worker can write there.
WIEPLAY_WORKER_UID=1000
WIEPLAY_WORKER_GID=1000
