# ~/stacks/nomal-worker-<env>/.env on the Lenovo server. No secrets here: the worker token
# lives in ./worker.token (0600) next to compose.yaml.
NOMAL_TAG=<git sha, set by scripts/deploy-worker.sh>

# The API through the SSH tunnel nomal-api-tunnel.service (next to this file; worker routes
# refuse anything that came through Cloudflare). It publishes the VPS's loopback-only APIs on
# the Docker bridge: dev http://172.17.0.1:18090, prod http://172.17.0.1:18091.
NOMAL_WORKER_API_URL=http://172.17.0.1:18090
# "analyse" adds a background lane for the automatic analysis (PLAN §10.1): it runs next to
# the media jobs, at low CPU priority, and never holds up an upload. Give the worker the cap
# in the API too: python -m nomal.cli add-worker-cap <name> analyse
NOMAL_WORKER_CAPS=ingest,transcode,thumbs,nas,inbox,analyse
NOMAL_WORKER_ENCODER=vaapi
NOMAL_WORKER_THREADS=6
# Threads for the ball tracker (ONNX Runtime); decoding uses VAAPI, else the CPU.
NOMAL_WORKER_ANALYSIS_THREADS=6
NOMAL_WORKER_ANALYSIS_HWACCEL=vaapi

# NAS shares, mounted on the Lenovo server (autofs). dev and prod use separate folders.
NOMAL_NAS_RAW=/mnt/nas/nomal/raw-dev
NOMAL_NAS_INBOX=/mnt/nas/nomal/inbox-dev
# Analysis signals and rally models (mkdir once; owned like raw/).
NOMAL_NAS_ANALYSIS=/mnt/nas/nomal/analysis-dev
NOMAL_RENDER_GID=<getent group render | cut -d: -f3>
# Owner of the NAS mount (fstab uid=/gid=), so the worker can write there.
NOMAL_WORKER_UID=1000
NOMAL_WORKER_GID=1000
