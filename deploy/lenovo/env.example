# ~/stacks/nomal-worker-<env>/.env on the Lenovo server. No secrets here: the worker token
# lives in ./worker.token (0600) next to compose.yaml.
NOMAL_TAG=<git sha, set by scripts/deploy-worker.sh>

# The API over the tailnet (worker routes refuse anything that came through Cloudflare).
# The VPS publishes Nomal on its tailnet address too (deploy/hetzner/compose.yaml).
NOMAL_WORKER_API_URL=http://<vps tailnet ip>:8090
NOMAL_WORKER_CAPS=ingest,transcode,thumbs,nas,inbox
NOMAL_WORKER_ENCODER=vaapi
NOMAL_WORKER_THREADS=6

# NAS shares, mounted on the Lenovo server (autofs). dev and prod use separate folders.
NOMAL_NAS_RAW=/mnt/nas/nomal/raw-dev
NOMAL_NAS_INBOX=/mnt/nas/nomal/inbox-dev
NOMAL_RENDER_GID=<getent group render | cut -d: -f3>
# Owner of the NAS mount (fstab uid=/gid=), so the worker can write there.
NOMAL_WORKER_UID=1000
NOMAL_WORKER_GID=1000
