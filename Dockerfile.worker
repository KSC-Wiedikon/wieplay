# Nomal media worker image (Lenovo server): ffmpeg with VAAPI for the Radeon iGPU, and
# Node.js for yt-dlp's YouTube JavaScript challenges (imports, PLAN §7.2.2).
#   docker build -f Dockerfile.worker -t nomal-worker:<tag> .
# Runs `python -m nomal.worker`; settings come from NOMAL_WORKER_* (deploy/lenovo/).

FROM python:3.12-slim-trixie
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg mesa-va-drivers nodejs \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /usr/local/bin/uv
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
RUN uv sync --frozen --no-dev && useradd --system --uid 10001 --create-home nomal
# Scratch space (the `work` volume in deploy/lenovo/compose.yaml). The worker runs as the
# host user that owns the NAS share (any uid), so the folder is world-writable and sticky;
# a new named volume copies this mode, an existing one needs `chmod 1777` once.
RUN mkdir -p /work && chmod 1777 /work
ENV PATH="/app/.venv/bin:$PATH"
USER nomal
CMD ["python", "-m", "nomal.worker"]
