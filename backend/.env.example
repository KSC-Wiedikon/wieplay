# Local development (copy to backend/.env). Postgres from `docker compose up -d` at the repo root.
NOMAL_ENV=local
NOMAL_DATABASE_URL=postgresql+psycopg://nomal:nomal@127.0.0.1:55488/nomal
NOMAL_PUBLIC_URL=http://localhost:5173
NOMAL_BRIDGE_AUTHORIZE_URL=http://localhost:5173/api/dev-bridge/authorize
NOMAL_DEV_BRIDGE=true
NOMAL_COOKIE_SECURE=false
NOMAL_SYNC_INTERVAL_MINUTES=0
