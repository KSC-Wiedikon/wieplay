# Local development (copy to backend/.env). Postgres from `docker compose up -d` at the repo root.
WIEPLAY_ENV=local
WIEPLAY_DATABASE_URL=postgresql+psycopg://wieplay:wieplay@127.0.0.1:55488/wieplay
WIEPLAY_PUBLIC_URL=http://localhost:5173
WIEPLAY_BRIDGE_AUTHORIZE_URL=http://localhost:5173/api/dev-bridge/authorize
WIEPLAY_DEV_BRIDGE=true
WIEPLAY_COOKIE_SECURE=false
WIEPLAY_SYNC_INTERVAL_MINUTES=0
